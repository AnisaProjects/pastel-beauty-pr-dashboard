# Connection string for the Postgres database used to store PR dashboard data.
#
# Easiest setup: in the Vercel dashboard, go to your project -> Storage -> Create
# Database -> Postgres, then attach it to this project. Vercel will inject
# POSTGRES_URL (and related POSTGRES_* vars) into your deployments automatically —
# you do not need to copy/paste anything for production.
#
# For local development with `vercel dev`, run:
#   vercel env pull .env.local
# which will fetch this value for you. Or paste your own Postgres connection
# string below if you're using a different provider (Neon, Supabase, etc).
POSTGRES_URL=

# Random secret NextAuth (Auth.js) uses to sign/encrypt session JWTs.
# Generate one with:  npx auth secret   (or: openssl rand -base64 32)
# Required in production — the app will fail to authenticate sessions without it.
AUTH_SECRET=

# OpenAI API key used by the AI report pipeline (Stage 2, POST /api/reports).
# Create one at https://platform.openai.com/api-keys. Without this set, the
# app still builds/runs fine — report generation just returns a 503 until
# it's configured.
OPENAI_API_KEY=

# Optional: override the model used for report generation (defaults to
# gpt-5.4-mini if unset).
# OPENAI_MODEL=
